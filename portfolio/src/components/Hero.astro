---
import { getLocale, path, type Lang } from "../data/index";

interface Props { lang: Lang }
const { lang } = Astro.props;
const { profile, t } = getLocale(lang);
---

<section class="hero">
  <div class="container">
    <div class="hero-status">
      <span class="status-dot"></span>
      <span>{profile.upwork ? t.hero.statusUpwork : t.hero.status}</span>
    </div>
    <h1 class="hero-name">{profile.name}</h1>
    <p class="hero-title">{profile.title}</p>
    <p class="hero-tagline">{profile.tagline}</p>
    <p class="hero-bio">{profile.bio}</p>
    <div class="hero-actions">
      <a href={path(lang, "/#projects")} class="btn-primary">{t.hero.viewWork}</a>
      <a href={path(lang, "/#contact")} class="btn-secondary">{t.hero.contactMe}</a>
      {profile.github && <a href={profile.github} target="_blank" rel="noopener" class="btn-ghost">GitHub →</a>}
    </div>
  </div>
</section>

<style>
  .hero { padding: 100px 0 80px; }
  .hero-status {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 0.85rem; color: var(--c-text-muted); margin-bottom: 20px;
  }
  .status-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--c-green); box-shadow: 0 0 8px var(--c-green);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
  .hero-name {
    font-size: 2.8rem; font-weight: 800; margin: 0 0 4px;
    letter-spacing: -0.02em; line-height: 1.1;
  }
  .hero-title { font-size: 1.3rem; color: var(--c-accent); margin: 0 0 16px; font-weight: 600; }
  .hero-tagline { font-size: 1.1rem; color: var(--c-text-muted); margin: 0 0 24px; max-width: 540px; }
  .hero-bio { font-size: 1rem; color: var(--c-text-muted); margin: 0 0 32px; max-width: 540px; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary {
    padding: 10px 24px; border-radius: 8px; background: var(--c-accent);
    color: #fff; font-weight: 600; font-size: 0.95rem;
    transition: background 0.15s, transform 0.1s;
  }
  .btn-primary:hover { background: var(--c-accent-hover); color: #fff; }
  .btn-primary:active { transform: scale(0.97); }
  .btn-secondary {
    padding: 10px 24px; border-radius: 8px; border: 1px solid var(--c-border);
    color: var(--c-text); font-weight: 500; font-size: 0.95rem;
    transition: border-color 0.15s;
  }
  .btn-secondary:hover { border-color: var(--c-border-hover); color: var(--c-text); }
  .btn-ghost { padding: 10px 16px; color: var(--c-text-muted); font-weight: 500; font-size: 0.95rem; }
  .btn-ghost:hover { color: var(--c-text); }

  @media (max-width: 640px) {
    .hero { padding: 60px 0 40px; }
    .hero-name { font-size: 2rem; }
    .hero-title { font-size: 1.1rem; }
    .hero-tagline { font-size: 1rem; }
  }
</style>